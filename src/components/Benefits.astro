---
import { benefits } from '../data/content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="py-20 lg:py-28" aria-labelledby="vorteile-title">
  <div class="container-page">
    <SectionHeading eyebrow="Warum zu uns" title="Schöne Nägel, mit Ruhe gemacht" id="vorteile-title">
      Kundinnen kommen wieder, weil hier sorgfältig gearbeitet wird – und weil man sich wohlfühlt.
    </SectionHeading>

    <ul class="grid gap-px overflow-hidden rounded-md bg-gold/25 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((b, i) => (
          <li class="flex gap-5 bg-cream p-6 sm:block sm:p-8 lg:p-9" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="inline-flex size-12 shrink-0 items-center sm:size-14 justify-center rounded-full border border-gold/50 text-gold-dark">
              <Icon name={b.icon} size={26} />
            </span>
            <div>
              <h3 class="text-[1.5rem] text-ink sm:mt-6 sm:text-[1.65rem]">{b.title}</h3>
              <p class="mt-2 text-[0.98rem] text-muted sm:mt-3">{b.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
