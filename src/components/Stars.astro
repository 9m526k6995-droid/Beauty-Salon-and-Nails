---
/** Sternebewertung mit anteiliger Füllung (z. B. 4,4). */
import Icon from './Icon.astro';

interface Props {
  value: number;
  size?: number;
  class?: string;
}
const { value, size = 18, class: className = '' } = Astro.props;
const percent = Math.max(0, Math.min(100, (value / 5) * 100));
const label = `${value.toLocaleString('de-DE')} von 5 Sternen`;
---

<span class:list={['relative inline-flex', className]} role="img" aria-label={label}>
  <span class="flex text-current opacity-25" aria-hidden="true">
    {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={size} />)}
  </span>
  <span class="absolute inset-y-0 left-0 flex overflow-hidden whitespace-nowrap" style={`width:${percent}%`} aria-hidden="true">
    {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={size} class="shrink-0" />)}
  </span>
</span>
