---
import { site } from '../config/site';
import { navigation } from '../data/content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-night pt-16 pb-28 text-cream/75 lg:pb-12">
  <div class="container-page">
    <div class="grid gap-12 border-b border-gold/20 pb-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <Logo variant="gold" height={90} class="h-[5.5rem] w-auto" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed">
          Nagelstudio & Wimpernverlängerung in der Passauer Innenstadt. Persönlich geführt von {site.owner}.
        </p>
      </div>

      <div>
        <h2 class="font-sans text-xs font-medium tracking-[0.25em] text-gold uppercase">Kontakt</h2>
        <ul class="mt-5 space-y-3 text-sm">
          <li>
            <a href={site.phone.href} class="inline-flex items-center gap-2.5 hover:text-gold-light">
              <Icon name="phone" size={16} class="text-gold" />
              {site.phone.display}
            </a>
          </li>
          <li>
            <a href={site.whatsapp.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 hover:text-gold-light">
              <Icon name="whatsapp" size={16} class="text-gold" />
              WhatsApp
            </a>
          </li>
          <li>
            <a href={site.instagram.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 hover:text-gold-light">
              <Icon name="instagram" size={16} class="text-gold" />
              {site.instagram.handle}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-xs font-medium tracking-[0.25em] text-gold uppercase">Studio</h2>
        <address class="mt-5 text-sm leading-relaxed not-italic">
          {site.address.street}<br />
          {`${site.address.zip} ${site.address.city}`}
        </address>
        <p class="mt-3 text-sm">{site.openingHoursShort}<br />Sonntag geschlossen</p>
        <a href={site.googleMaps.href} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm text-gold-light hover:text-gold">
          Route planen <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <nav aria-label="Footer-Navigation">
        <h2 class="font-sans text-xs font-medium tracking-[0.25em] text-gold uppercase">Seiten</h2>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            navigation.map((n) => (
              <li>
                <a href={n.href} class="hover:text-gold-light">
                  {n.label}
                </a>
              </li>
            ))
          }
          <li><a href="/impressum/" class="hover:text-gold-light">Impressum</a></li>
          <li><a href="/datenschutz/" class="hover:text-gold-light">Datenschutz</a></li>
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-3 pt-8 text-xs text-cream/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · {site.owner} · Passau</p>
      <p class="flex gap-5">
        <a href="/impressum/" class="hover:text-gold-light">Impressum</a>
        <a href="/datenschutz/" class="hover:text-gold-light">Datenschutz</a>
      </p>
    </div>
  </div>
</footer>
