---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  align?: 'center' | 'left';
  tone?: 'light' | 'dark';
}
const { eyebrow, title, id, align = 'center', tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div class:list={['mb-12 lg:mb-16', align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl']} data-reveal>
  <p class:list={['eyebrow', dark ? 'text-gold' : 'text-gold-dark']}>{eyebrow}</p>
  <h2 id={id} class:list={['mt-4 text-4xl sm:text-5xl', dark ? 'text-cream' : 'text-ink']}>{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class:list={['mt-5 text-lg', dark ? 'text-cream/70' : 'text-muted']}>
        <slot />
      </div>
    )
  }
</div>
