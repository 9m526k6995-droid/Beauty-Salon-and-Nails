---
import { site } from '../config/site';
import { reviewHighlights, reviews } from '../data/reviews';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import Stars from './Stars.astro';

const shown = reviews.slice(0, 4);
---

<section id="bewertungen" class="py-20 lg:py-28" aria-labelledby="bewertungen-title">
  <div class="container-page">
    <SectionHeading eyebrow="Bewertungen" title="Was Kundinnen sagen" id="bewertungen-title" />

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div class="rounded-md border border-gold/40 bg-cream p-8 text-center sm:p-10" data-reveal>
        <p class="font-serif text-7xl leading-none text-ink">{site.rating.value.toLocaleString('de-DE')}</p>
        <Stars value={site.rating.value} size={26} class="mt-4 text-gold" />
        <p class="mt-3 text-muted">aus {site.rating.count} Google-Bewertungen</p>
        <a
          href={site.googleMaps.href}
          target="_blank"
          rel="noopener"
          class="btn btn-outline-dark mt-7 w-full text-sm"
        >
          Alle Bewertungen auf Google
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <div>
        {
          shown.length > 0 && (
            <ul class="mb-10 grid gap-5 sm:grid-cols-2">
              {shown.map((r, i) => (
                <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
                  <figure class="flex h-full flex-col rounded-md bg-rose-soft p-7">
                    <Stars value={r.stars} size={16} class="text-gold-dark" />
                    <blockquote class="mt-4 flex-1 font-serif text-xl leading-snug text-ink">„{r.text}“</blockquote>
                    <figcaption class="mt-5 text-sm text-muted">
                      {r.author}
                      {r.source && <span> · {r.source}</span>}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )
        }

        <div data-reveal>
          <h3 class="font-sans text-sm font-medium tracking-[0.2em] text-gold-dark uppercase">
            Das heben Kundinnen immer wieder hervor
          </h3>
          <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            {
              reviewHighlights.map((h) => (
                <li class="flex items-start gap-3 border-b border-ink/8 pb-4 text-ink">
                  <Icon name="sparkle" size={18} class="mt-1 shrink-0 text-gold-dark" />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
