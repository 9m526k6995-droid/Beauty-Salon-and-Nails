---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description} solidHeader noindex>
  <section class="pt-32 pb-20 lg:pt-40 lg:pb-28">
    <div class="container-page max-w-3xl">
      <p class="eyebrow text-gold-dark">Rechtliches</p>
      <h1 class="mt-4 text-5xl text-ink sm:text-6xl">{heading}</h1>
      <div class="prose-legal mt-10">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
