---
import { site } from '../config/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="anfahrt" class="bg-cream-deep/60 py-20 lg:py-28" aria-labelledby="anfahrt-title">
  <div class="container-page">
    <SectionHeading eyebrow="Öffnungszeiten & Anfahrt" title="Mitten in Passau" id="anfahrt-title" />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,26rem)_1fr]">
      <div class="flex flex-col gap-8" data-reveal>
        <div class="rounded-md border border-gold/30 bg-cream p-7 sm:p-9">
          <h3 class="flex items-center gap-3 text-[1.75rem] text-ink">
            <Icon name="clock" size={22} class="text-gold-dark" />
            Öffnungszeiten
          </h3>
          <table class="mt-5 -mx-3 w-[calc(100%+1.5rem)] text-[0.98rem]" id="hours-table">
            <caption class="sr-only">Öffnungszeiten von {site.name}</caption>
            <tbody>
              {
                site.openingHours.map((d) => (
                  <tr data-day={d.day} class="border-b border-ink/8 last:border-0">
                    <th scope="row" class="px-3 py-2.5 text-left font-normal text-ink">
                      {d.label}
                      <span class="today-badge ml-2 hidden rounded-full bg-teal px-2 py-0.5 align-middle text-[0.7rem] font-medium tracking-wide text-cream uppercase">
                        Heute
                      </span>
                    </th>
                    <td class:list={['px-3 py-2.5 text-right', d.closed ? 'text-muted' : 'text-ink']}>
                      {d.closed ? 'geschlossen' : `${d.open} – ${d.close} Uhr`}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="rounded-md border border-gold/30 bg-cream p-7 sm:p-9">
          <h3 class="flex items-center gap-3 text-[1.75rem] text-ink">
            <Icon name="pin" size={22} class="text-gold-dark" />
            Adresse
          </h3>
          <address class="mt-4 text-lg leading-relaxed text-ink not-italic">
            {site.name}<br />
            {site.address.street}<br />
            {`${site.address.zip} ${site.address.city}`}
          </address>
          <p class="mt-2 text-muted">{site.address.hint}</p>
          <a href={site.googleMaps.href} target="_blank" rel="noopener" class="btn btn-teal mt-6 w-full sm:w-auto">
            <Icon name="route" size={19} />
            Route planen
          </a>
        </div>
      </div>

      <!-- Karte: Zwei-Klick-Lösung. Google Maps wird erst nach Zustimmung geladen. -->
      <div
        class="relative min-h-[24rem] overflow-hidden rounded-md bg-night text-cream ring-1 ring-gold/30 lg:min-h-full"
        id="map-consent"
        data-src={site.googleMaps.embed}
        data-reveal
      >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full opacity-[0.16]" preserveAspectRatio="xMidYMid slice" viewBox="0 0 600 500">
            <g fill="none" stroke="#c2a15f" stroke-width="1">
              <path d="M-20 340 C 120 300, 200 360, 320 320 S 520 250, 640 290" stroke-width="18" stroke="#0e606b" opacity=".9" />
              <path d="M-20 120 C 100 160, 220 90, 330 140 S 520 190, 640 130" stroke-width="12" stroke="#0e606b" opacity=".6" />
              <path d="M60 -10 L 140 520 M 240 -10 L 280 520 M 400 -10 L 360 520 M 520 -10 L 560 520" />
              <path d="M-10 60 L 610 90 M -10 220 L 610 200 M -10 420 L 610 440" />
              <path d="M140 220 L 280 210 L 360 260 L 420 230" stroke-width="2" />
            </g>
          </svg>
          <div class="absolute top-1/2 left-1/2 size-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold/15 blur-3xl"></div>
        </div>

        <div class="relative flex h-full min-h-[24rem] flex-col items-center justify-center gap-5 p-8 text-center">
          <span class="inline-flex size-16 items-center justify-center rounded-full border border-gold/60 bg-night/70 text-gold">
            <Icon name="pin" size={30} />
          </span>
          <p class="font-serif text-3xl">{site.address.street}</p>
          <p class="max-w-sm text-sm leading-relaxed text-cream/70">
            Beim Laden der Karte werden Daten (u. a. Deine IP-Adresse) an Google übertragen. Mehr dazu in der{' '}
            <a href="/datenschutz/#google-maps" class="text-gold-light underline underline-offset-4">Datenschutzerklärung</a>.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <button type="button" id="map-load" class="btn btn-gold">
              <Icon name="map" size={19} />
              Karte laden
            </button>
            <a href={site.googleMaps.href} target="_blank" rel="noopener" class="btn btn-outline-light">
              In Google Maps öffnen
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Heutigen Tag hervorheben (Zeitzone Europe/Berlin)
  const wd = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Berlin', weekday: 'short' }).format(new Date());
  const map: Record<string, number> = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
  const row = document.querySelector<HTMLTableRowElement>(`#hours-table tr[data-day="${map[wd]}"]`);
  if (row) {
    row.classList.add('bg-rose-soft', 'font-medium');
    row.setAttribute('aria-current', 'date');
    row.querySelector('.today-badge')?.classList.remove('hidden');
  }

  // Zwei-Klick-Karte
  const box = document.getElementById('map-consent');
  document.getElementById('map-load')?.addEventListener('click', () => {
    if (!box) return;
    const iframe = document.createElement('iframe');
    iframe.src = box.dataset.src ?? '';
    iframe.title = 'Karte: Standort von Beauty Salon & Nails in Passau';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    iframe.setAttribute('allowfullscreen', '');
    box.replaceChildren(iframe);
    iframe.focus();
  });
</script>
