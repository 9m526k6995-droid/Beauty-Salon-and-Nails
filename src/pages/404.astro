---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden | Beauty Salon & Nails Passau" description="Diese Seite gibt es leider nicht." solidHeader noindex>
  <section class="flex min-h-[70vh] items-center pt-32 pb-20">
    <div class="container-page max-w-xl text-center">
      <p class="eyebrow text-gold-dark">Fehler 404</p>
      <h1 class="mt-4 text-5xl text-ink sm:text-6xl">Diese Seite gibt es leider nicht</h1>
      <p class="mt-5 text-lg text-muted">Vielleicht hilft Dir die Startseite weiter.</p>
      <a href="/" class="btn btn-teal mt-8">Zur Startseite</a>
    </div>
  </section>
</BaseLayout>
